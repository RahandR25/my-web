  <br>
  <a href="http://www.example.com">
    <img src="https://via.placeholder.com/150" alt="Clickable image link">
  </a>

  <h2>iFrame</h2>
  <iframe src="https://www.wikipedia.org" width="400" height="200"></iframe>

